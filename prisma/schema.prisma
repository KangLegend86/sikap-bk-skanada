generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GURU_BK
  GURU_PJR
  GURU
}

enum JenisJurnalSikap {
  BERPRESTASI
  BERMASALAH
  HOME_VISIT
}

enum JenisKelamin {
  L
  P
}

enum StatusKasus {
  DALAM_PROSES
  SELESAI
}

model Pegawai {
  id                  String        @id @default(cuid())
  nip_nik             String?       @unique
  nama_lengkap        String
  jenis_kelamin       JenisKelamin
  no_whatsapp         String?
  akun                UserAccount[]
  jurnal_dibuat       JurnalBk[]    @relation("KonselorJurnal")
  jurnal_sikap_dibuat JurnalSikap[] @relation("KonselorJurnalSikap")
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt
}

model UserAccount {
  id                  String        @id @default(cuid())
  username            String        @unique
  password_hash       String
  role                Role
  is_active           Boolean       @default(true)
  pegawai_id          String
  pegawai             Pegawai       @relation(fields: [pegawai_id], references: [id], onDelete: Cascade)
  ruang_kelas_id      String?       // Khusus role GURU_PJR atau GURU_BK yang merangkap PJR
  ruang_kelas         RuangKelas?   @relation(fields: [ruang_kelas_id], references: [id], onDelete: SetNull)
  feedback_pjr        PjrFeedback[]
  jurnal_sikap_input  JurnalSikap[] @relation("CreatorJurnalSikap")
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt
}

model Jurusan {
  id           String   @id @default(cuid())
  kode         String   @unique // TKR, TSM, TKJ, DKV, BISDIG, DPB
  nama_lengkap String
  is_active    Boolean  @default(true)
  siswa        Siswa[]
}

model RuangKelas {
  id         String        @id @default(cuid())
  nama_ruang String        @unique // X-A s/d XII-E
  tingkat    String        // X, XI, XII
  is_active  Boolean       @default(true)
  siswa      Siswa[]
  akun_pjr   UserAccount[]
}

model Siswa {
  id             String       @id @default(cuid())
  no_absen       Int?
  nama_lengkap   String
  jenis_kelamin  JenisKelamin
  jurusan_id     String
  jurusan        Jurusan      @relation(fields: [jurusan_id], references: [id])
  ruang_kelas_id String
  ruang_kelas    RuangKelas   @relation(fields: [ruang_kelas_id], references: [id])
  nama_wali      String?
  no_hp_ortu     String?
  is_active      Boolean       @default(true)
  jurnal         JurnalBk[]
  jurnal_sikap   JurnalSikap[]
  created_at     DateTime      @default(now())
  updated_at     DateTime     @updatedAt

  @@index([is_active, ruang_kelas_id])
  @@index([jurusan_id])
}

model KategoriBk {
  id            String           @id @default(cuid())
  nama_kategori String           @unique
  is_active     Boolean          @default(true)
  jurnal        JurnalKategori[]
}

model JurnalBk {
  id                 String           @id @default(cuid())
  tanggal_konseling  DateTime         @default(now())
  siswa_id           String
  siswa              Siswa            @relation(fields: [siswa_id], references: [id], onDelete: Cascade)
  guru_bk_id         String
  guru_bk            Pegawai          @relation("KonselorJurnal", fields: [guru_bk_id], references: [id])
  snapshot_ruang     String
  snapshot_pjr       String?
  kategori           JurnalKategori[]
  permasalahan       String           @db.Text
  kendala            String?          @db.Text
  solusi             String?          @db.Text
  tindak_lanjut      String           @db.Text
  catatan            String?          @db.Text // Ikut tampil ke PJR jika is_shared_with_pjr = true
  status             StatusKasus      @default(DALAM_PROSES)
  keterangan_status  String?          @db.Text
  is_shared_with_pjr Boolean          @default(false)
  feedback           PjrFeedback[]
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  @@index([tanggal_konseling(sort: Desc), created_at(sort: Desc)])
  @@index([status])
  @@index([snapshot_ruang])
  @@index([siswa_id])
}

model JurnalKategori {
  jurnal_id   String
  kategori_id String
  jurnal      JurnalBk   @relation(fields: [jurnal_id], references: [id], onDelete: Cascade)
  kategori    KategoriBk @relation(fields: [kategori_id], references: [id], onDelete: Restrict)

  @@id([jurnal_id, kategori_id])
}

model PjrFeedback {
  id             String      @id @default(cuid())
  jurnal_id      String
  jurnal         JurnalBk    @relation(fields: [jurnal_id], references: [id], onDelete: Cascade)
  user_pjr_id    String
  user_pjr       UserAccount @relation(fields: [user_pjr_id], references: [id])
  pesan_pantauan String      @db.Text
  created_at     DateTime    @default(now())
}

model JurnalSikap {
  id             String           @id @default(cuid())
  tanggal        DateTime         @default(now())
  siswa_id       String
  siswa          Siswa            @relation(fields: [siswa_id], references: [id], onDelete: Cascade)
  snapshot_ruang String
  jenis          JenisJurnalSikap
  // Field khusus BERPRESTASI
  prestasi_dalam String?          @db.Text
  sikap_perilaku String?          @db.Text
  // Field khusus BERMASALAH & HOME_VISIT
  permasalahan   String?          @db.Text
  kendala        String?          @db.Text
  solusi         String?          @db.Text
  // Field umum
  catatan        String?          @db.Text
  tindak_lanjut  String           @db.Text
  // Field khusus HOME_VISIT (opsional — foto pertama tetap disimpan di sini untuk kompatibilitas,
  // dan seluruh foto tersimpan di relasi foto_list)
  foto_drive_id  String?
  foto_file_name String?
  foto_list      JurnalSikapFoto[]
  // Konselor / Guru yang dipilih & akun penginput
  konselor_id    String
  konselor       Pegawai          @relation("KonselorJurnalSikap", fields: [konselor_id], references: [id])
  created_by_id  String
  created_by     UserAccount      @relation("CreatorJurnalSikap", fields: [created_by_id], references: [id])
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
}

model JurnalSikapFoto {
  id              String      @id @default(cuid())
  jurnal_sikap_id String
  jurnal_sikap    JurnalSikap @relation(fields: [jurnal_sikap_id], references: [id], onDelete: Cascade)
  drive_id        String
  file_name       String?
  urutan          Int         @default(0)
  created_at      DateTime    @default(now())
}

